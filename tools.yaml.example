# Guarded tools that agents (and you) can run. DENY-BY-DEFAULT: only tools
# listed here can ever execute. No tools.yaml = the feature is off.
#
# Each tool runs as a FIXED argv with NO shell. The command and `cwd` come from
# this file, never from the agent. An agent may only fill the named
# {placeholders} declared in `args`, and each value is validated (no spaces, no
# shell metacharacters, bounded length) before use.
#
# Every call is PENDING until you approve it in the dashboard, UNLESS the tool
# sets `auto_approve: true` — reserve that for safe, read-only tools.
#
# Copy to tools.yaml and edit:  cp tools.yaml.example tools.yaml

tools:
  - name: disk_free
    description: Show free disk space.
    argv: ["df", "-h"]
    timeout_seconds: 10
    auto_approve: true          # safe + read-only → runs without approval

  - name: list_dir
    description: List a directory.
    argv: ["ls", "-la", "{path}"]
    args: [path]                # agent supplies {path}; validated, no shell
    cwd: /
    timeout_seconds: 10
    # no auto_approve → requires human approval in the dashboard

  - name: run_tests
    description: Run the project's test suite.
    argv: ["./scripts/test.sh"]
    cwd: /opt/myproject
    timeout_seconds: 300

  # --- GitHub (agents act on GitHub via the `gh` CLI) ---
  # These let disciples read and act on GitHub. Reads are safe to auto-approve;
  # anything that writes (comment, PR) stays human-approved by default. Requires
  # the `gh` CLI to be installed and authenticated on the agent host.
  - name: gh_pr_list
    description: List open pull requests in a repo.
    argv: ["gh", "pr", "list", "--repo", "{repo}", "--limit", "20"]
    args: [repo]                # e.g. owner/name; validated, no shell
    timeout_seconds: 30
    auto_approve: true          # read-only

  - name: gh_issue_view
    description: View a GitHub issue.
    argv: ["gh", "issue", "view", "{number}", "--repo", "{repo}"]
    args: [repo, number]
    timeout_seconds: 30
    auto_approve: true          # read-only

  - name: gh_issue_comment
    description: Comment on a GitHub issue or PR (WRITE — stays human-approved).
    argv: ["gh", "issue", "comment", "{number}", "--repo", "{repo}", "--body", "{body}"]
    args: [repo, number, body]
    timeout_seconds: 30
    # no auto_approve → the Ancestor approves each comment before it posts

  # --- Chaos / Tribulation Trials (active fault injection) ---
  # Mapped from chaos fault kinds (see chaos.FAULT_TOOLS). DESTRUCTIVE by design,
  # so NEVER auto_approve — every injection is approved by the Ancestor. Point
  # these at YOUR fault scripts; {target} is the project/realm the trial names.
  - name: chaos_process_kill
    description: "Tribulation: kill the target service process (game-day drill)."
    argv: ["./scripts/chaos/kill.sh", "{target}"]
    cwd: /opt/myproject
    timeout_seconds: 30
  - name: chaos_latency_storm
    description: "Tribulation: inject network latency against the target."
    argv: ["./scripts/chaos/latency.sh", "{target}"]
    cwd: /opt/myproject
    timeout_seconds: 30
  - name: chaos_endpoint_seal
    description: "Tribulation: block the target endpoint (simulate an outage)."
    argv: ["./scripts/chaos/seal.sh", "{target}"]
    cwd: /opt/myproject
    timeout_seconds: 30

  # --- Learning Center real-command pentest labs (DEFAULT OFF) ---------------
  # The real-world toolkit. Only loaded when MAYBOT_REAL_LABS=1 and
  # real_targets.yaml binds a lab host to an isolated sandbox target. Run the
  # maybot_agent that executes these INSIDE the isolated microVM/sandbox network
  # only (see docs/REAL_LABS.md), reachable to the lab subnet and NOTHING else.
  #
  # SAFETY: each tool is a FIXED argv (no shell). {target} is the only agent-
  # supplied value and is validated (no spaces, no shell metacharacters). Each
  # tool pins ONE action/module — never let the agent choose the module/flags.
  # Never auto_approve: a human approves every run. Install these on a Kali-based
  # attacker image. Match the names referenced by real_targets.yaml.

  # -- recon / enumeration --
  - name: nmap_scan
    description: "Service/version scan of a single lab host."
    argv: ["nmap", "-sV", "-Pn", "--top-ports", "200", "{target}"]
    args: [target]
    timeout_seconds: 120
  - name: whatweb_scan
    description: "Fingerprint a web host's tech stack."
    argv: ["whatweb", "--no-errors", "{target}"]
    args: [target]
    timeout_seconds: 60
  - name: nikto_scan
    description: "Web server vulnerability scan of a lab host."
    argv: ["nikto", "-host", "{target}"]
    args: [target]
    timeout_seconds: 180
  - name: gobuster_dir
    description: "Directory/content discovery against a lab web host."
    argv: ["gobuster", "dir", "-q", "-u", "{target}", "-w", "/usr/share/wordlists/dirb/common.txt"]
    args: [target]
    timeout_seconds: 180
  - name: wpscan_scan
    description: "WordPress enumeration (plugins, users, known CVEs)."
    argv: ["wpscan", "--no-banner", "--url", "{target}"]
    args: [target]
    timeout_seconds: 240
  - name: enum4linux_scan
    description: "SMB / Windows / AD enumeration of a lab host."
    argv: ["enum4linux-ng", "-A", "{target}"]
    args: [target]
    timeout_seconds: 180
  - name: smbmap_scan
    description: "Enumerate SMB shares and access rights."
    argv: ["smbmap", "-H", "{target}"]
    args: [target]
    timeout_seconds: 120
  - name: searchsploit_lookup
    description: "Look up public exploits for a discovered service/term."
    argv: ["searchsploit", "{target}"]    # {target} = validated search term
    args: [target]
    timeout_seconds: 30

  # -- exploitation --
  - name: sqlmap_test
    description: "Test a URL for SQL injection (batch, non-interactive)."
    argv: ["sqlmap", "-u", "{target}", "--batch", "--level", "2", "--risk", "1"]
    args: [target]
    timeout_seconds: 300
  - name: hydra_spray
    description: "Online password attack against SSH on a lab host (small list)."
    argv: ["hydra", "-L", "/opt/wordlists/users.txt", "-P", "/opt/wordlists/pass-top100.txt",
           "-t", "4", "-f", "{target}", "ssh"]
    args: [target]
    timeout_seconds: 300
  # Metasploit, BOUNDED: one fixed auxiliary module, only RHOSTS parameterized.
  # {target} is embedded in a single -x string arg (no shell, validated), so the
  # agent cannot swap the module. Add one tool per module you choose to allow.
  - name: msf_smb_version
    description: "Metasploit: SMB version auxiliary scanner (bounded module)."
    argv: ["msfconsole", "-q", "-x",
           "use auxiliary/scanner/smb/smb_version; set RHOSTS {target}; run; exit"]
    args: [target]
    timeout_seconds: 180

  # -- privilege escalation (run ON a foothold via the agent's session) --
  - name: linpeas_run
    description: "linPEAS: enumerate local privesc vectors on the foothold."
    argv: ["linpeas", "-t", "{target}"]   # {target} = the foothold session/host id
    args: [target]
    timeout_seconds: 240
  - name: pspy_run
    description: "pspy: watch processes/cron for privesc without root."
    argv: ["pspy64", "-p", "-i", "1000", "{target}"]
    args: [target]
    timeout_seconds: 120

  # -- lateral movement / post-exploitation / persistence --
  - name: nxc_smb
    description: "NetExec/CrackMapExec: validate creds + enumerate over SMB."
    argv: ["nxc", "smb", "{target}", "-u", "/opt/wordlists/users.txt", "-p", "/opt/wordlists/pass-top100.txt"]
    args: [target]
    timeout_seconds: 180
  - name: impacket_secretsdump
    description: "Impacket secretsdump against a lab host (creds in a vault file)."
    argv: ["impacket-secretsdump", "-no-pass", "{target}"]
    args: [target]
    timeout_seconds: 180
  - name: john_crack
    description: "Crack a looted hash file with John (lab-local file under /opt/loot)."
    argv: ["john", "--wordlist=/opt/wordlists/rockyou-mini.txt", "/opt/loot/{target}"]
    args: [target]    # {target} = a validated filename
    timeout_seconds: 240
