# ============================================================================
#  MayBot Control Center — environment template
#  Copy to `.env` (which is gitignored) and fill in your secrets:
#      cp .env.example .env
#  `docker compose up` auto-loads `.env`. Everything below is ON by default;
#  comment a line out (or set it to 0 / empty) to disable that feature.
# ============================================================================

# ---- Security (set these before exposing on any network) -------------------
# Generate:  python3 -c "import secrets; print(secrets.token_hex(32))"
MAYBOT_CONTROL_CENTER_TOKEN=
# Shared secret between the control center and each agent. MUST match the
# api_token in devices.yaml and the agent host's MAYBOT_API_TOKEN.
MAYBOT_API_TOKEN=change-me

# ---- Control center -> agent TLS (OPTIONAL, OFF by default) ----------------
# Opt-in mutual TLS for the control center <-> agent HTTP link. Leave all three
# UNSET for the current behaviour (default verification, no client cert).
# 1) CA bundle (PEM) the control center uses to VERIFY each agent's server cert:
# MAYBOT_AGENT_CA=/etc/maybot/ca.crt
# 2) Client cert + key the control center PRESENTS to the agent (mutual TLS).
#    Both are required together; setting only one is ignored (warning logged).
# MAYBOT_AGENT_CLIENT_CERT=/etc/maybot/control-center.crt
# MAYBOT_AGENT_CLIENT_KEY=/etc/maybot/control-center.key
# Agent (server) side is DEPLOYMENT config: launch the agent's uvicorn with
#   --ssl-certfile/--ssl-keyfile --ssl-ca-certs --ssl-cert-reqs=2
# to require & verify client certs, and point devices.yaml URLs at https://.

# ---- LLM backend for the disciple agents (pick what you run) ---------------
# Claude-backed disciples (agents.yaml provider: claude):
ANTHROPIC_API_KEY=
# OpenAI-compatible / local backends are configured per-agent in agents.yaml
# (provider: ollama | openai_compatible, with a base_url). No global key needed
# for local models; set this only if an agent points at OpenAI itself.
OPENAI_API_KEY=

# ---- Persistence, retention & backups (ON) ---------------------------------
MAYBOT_DB=/data/maybot.db
MAYBOT_RETENTION_DAYS=90
MAYBOT_BACKUP_DIR=/data/backups
MAYBOT_BACKUP_INTERVAL_HOURS=24
MAYBOT_BACKUP_KEEP=14

# ---- Scheduled summary reports (ON: a daily digest to your channels) -------
MAYBOT_REPORT_INTERVAL_HOURS=24

# ---- Learning Center reminders (ON: daily streak/review nudges to channels) -
# Sends a once-a-day nudge (daytime) via the same notify channels when your
# streak is at risk or spaced-repetition reviews are due. (Needs a notify channel.)
MAYBOT_LEARNING_REMINDERS=1

# ---- Autonomous operations (ENABLED per your choice) -----------------------
# Autopilot: detect -> diagnose -> ACT (can restart/stop unhealthy bots and run
# remediation runbooks). Needs a reachable LLM backend to diagnose well.
MAYBOT_AUTOPILOT=1
# Agents auto-run guarded tools WITHOUT per-call approval (within a budget).
MAYBOT_AUTONOMY=1
# Agents may delegate tasks to subordinates.
MAYBOT_DELEGATION=1
# Disciples open REAL GitHub pull requests for fixes (needs `gh` in the image —
# installed in the Dockerfile — plus GH auth and a repo). Falls back to a
# review-only "proposed PR" when gh/repo aren't available.
MAYBOT_PR_ENABLED=1
# Default repo for PRs, e.g. "youruser/yourbot". Leave blank to resolve per task.
MAYBOT_PR_REPO=
# Token used by `gh` inside the container to push branches / open PRs.
GH_TOKEN=

# ---- Notification channels (set credentials to activate) -------------------
# Slack / Discord / generic webhook:
MAYBOT_SLACK_WEBHOOK=
MAYBOT_DISCORD_WEBHOOK=
MAYBOT_WEBHOOK_URL=
# Email (all three required to enable; SMTP_TO is comma-separated):
MAYBOT_SMTP_HOST=
MAYBOT_SMTP_FROM=
MAYBOT_SMTP_TO=
MAYBOT_SMTP_PORT=587
MAYBOT_SMTP_USER=
MAYBOT_SMTP_PASSWORD=
# Telegram (both required):
MAYBOT_TELEGRAM_TOKEN=
MAYBOT_TELEGRAM_CHAT_ID=
# PagerDuty (Events API v2): set the integration routing key to page on-call.
# Alert level maps to severity (error->error, warning->warning, info->info).
MAYBOT_PAGERDUTY_ROUTING_KEY=
# Opsgenie: API key + region (eu|us, default us). Level maps to priority.
MAYBOT_OPSGENIE_API_KEY=
MAYBOT_OPSGENIE_REGION=us

# ---- Alerting behaviour (sensible defaults; tune as needed) ----------------
MAYBOT_ALERT_RECOVERY=1
MAYBOT_ESCALATION=1
MAYBOT_ESCALATE_AFTER_SECONDS=900
MAYBOT_ACK_DEFAULT_MINUTES=60

# ---- Session / ACL ---------------------------------------------------------
MAYBOT_SESSION_TTL_MINUTES=720

# ---- Left OFF on purpose -------------------------------------------------
# Public, unauthenticated status page — exposes fleet health to anyone who can
# reach the host. Enable only behind a trusted network.
# MAYBOT_PUBLIC_STATUS=1

# --- Obsidian vault memory (agents read/write shared notes) ---
# Point this at an Obsidian vault folder to give the sect a persistent memory.
MAYBOT_OBSIDIAN_VAULT=
MAYBOT_OBSIDIAN_SUBDIR=MayBot

# --- Agent auto-enrollment (hosts announce themselves; no Add-host step) ---
# Set the same value on the dashboard and on each agent; agents then self-register.
MAYBOT_REGISTER_TOKEN=

# --- security (optional) ---
# Force sign-in even when no accounts exist yet (default off = open until first account).
MAYBOT_REQUIRE_AUTH=
# Content-Security-Policy: "1"/"on" applies a sane same-origin default (the UI
# has no inline scripts, so this is safe). ON.
MAYBOT_CSP=1
# Strict-Transport-Security: enable ONLY when served over HTTPS (it locks the
# browser to HTTPS for this host — turning it on without TLS makes the dashboard
# unreachable). Left OFF until you terminate TLS in front of the dashboard.
MAYBOT_HSTS=0

# ---- Performance & resilience (ON; safe, no external services needed) ------
# Async fleet poll: gather every agent's status concurrently with httpx on
# /api/overview (direct-HTTP fleets; auto-falls back to sync for tunnelled hosts).
MAYBOT_ASYNC_POLL=1
# Retry transient LLM failures (timeouts/429/5xx) with exponential backoff.
MAYBOT_LLM_RETRIES=2
MAYBOT_LLM_RETRY_BASE_MS=400
# Structured JSON logs (one JSON object per line — for log aggregators).
MAYBOT_JSON_LOGS=1

# ---- Observability (set the DSN to activate; metrics at /metrics/obs) -------
# Sentry error tracking — paste your project DSN to turn it on.
MAYBOT_SENTRY_DSN=
MAYBOT_SENTRY_TRACES_SAMPLE_RATE=0
MAYBOT_ENV=production

# ---- LLM spend caps (set a dollar amount to activate; 0 = unlimited) --------
# When the rolling spend hits the cap, LLM calls PAUSE until the window resets
# (alerts fire at 80% and 100% via your notify channels). Pick your own limits.
MAYBOT_BUDGET_DAILY_USD=0
MAYBOT_BUDGET_MONTHLY_USD=0

# ---- Encryption-at-rest for device api_tokens (set a key to activate) ------
# Generate once:  python -m maybot_control_center.secrets keygen
# Existing plaintext tokens migrate to enc: on next save. KEEP THIS KEY SAFE —
# losing it makes encrypted tokens unrecoverable.
MAYBOT_SECRET_KEY=

# ---- Multi-replica shared state (set to a Redis URL to activate) -----------
# Shares login sessions + rate-limiting across replicas so you can scale out.
# Single replica? You don't need this. See docker-compose.full.yml for a stack
# that wires Postgres + Redis with everything below already on.
MAYBOT_REDIS_URL=
# Postgres persistence (instead of the SQLite MAYBOT_DB above). NOTE: switching
# does NOT migrate your existing SQLite data — see docs/MIGRATIONS.md.
# MAYBOT_DB=postgresql://maybot:maybot@postgres:5432/maybot
